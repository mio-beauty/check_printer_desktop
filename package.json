{
  "name": "check_printer_desktop",
  "private": true,
  "version": "0.1.6",
  "description": "Windows desktop client (Electron + React) for check printing",
  "main": "dist-electron/main/index.js",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/mio-beauty/check_printer_desktop.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run dev:electron\"",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy_preload.mjs",
    "dev:electron": "npm run -s build:electron && wait-on http-get://127.0.0.1:5173 && electron .",
    "fake-printer": "node scripts/fake_printer_server.mjs",
    "build": "vite build && npm run -s build:electron",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^0.525.0",
    "semver": "^7.7.3",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.0.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "uz.miobeauty.check_printer_client",
    "productName": "CheckPrinterClient",
    "artifactName": "CheckPrinterClient-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [],
    "publish": [
      {
        "provider": "github",
        "owner": "mio-beauty",
        "repo": "check_printer_desktop"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}